# Server-side only. Never prefix with EXPO_PUBLIC_ or VITE_ — those
# prefixes cause Expo/Vite to inline the value into the client bundle,
# which is the exact key-exposure bug this proxy fixes. Only server/index.js
# reads this, via process.env.ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# App gate for POST /api/ai/generate. Required. If unset, the route fails
# closed (503). Send it as Authorization: Bearer <value>. Use a long random
# value. This is not the Anthropic key.
KAZI_APP_KEY=

# Same value as KAZI_APP_KEY, read by the Expo client. The EXPO_PUBLIC_
# prefix inlines it into the app binary, so treat it as an app identifier,
# not as a secret. It does not authorize arbitrary prompts.
EXPO_PUBLIC_KAZI_APP_KEY=

# Optional. Set only if a native (Expo) build is served from a different
# origin than the proxy server — the deployed server's public https URL.
# Leave unset for local/web dev, where the proxy shares the app's origin.
EXPO_PUBLIC_API_BASE_URL=

# Optional server pin. Defaults to claude-opus-4-5. The client cannot set this.
# KAZI_AI_MODEL=

# Spend cap hook. Unset cap = not enforced (dev). Before launch set a cap,
# an alert threshold, and a price so the estimate can block. Wire onAlert
# in createApp({ spend }) to something a person will see; the default logs.
# The in-memory rate limiter and spend ledger are dev-only (not shared).
# KAZI_AI_SPEND_CAP_USD=
# KAZI_AI_SPEND_ALERT_USD=
# KAZI_AI_USD_PER_MILLION_OUTPUT_TOKENS=
