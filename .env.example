# Server-side only. Never prefix with EXPO_PUBLIC_ or VITE_ — those
# prefixes cause Expo/Vite to inline the value into the client bundle,
# which is the exact key-exposure bug this proxy fixes. Only server/index.js
# reads this, via process.env.ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# Optional. Set only if a native (Expo) build is served from a different
# origin than the proxy server — the deployed server's public https URL.
# Leave unset for local/web dev, where the proxy shares the app's origin.
EXPO_PUBLIC_API_BASE_URL=
